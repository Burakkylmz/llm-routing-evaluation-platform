{
  "$defs": {
    "CallStatus": {
      "enum": [
        "SUCCESS",
        "FAILED",
        "TIMEOUT",
        "RATE_LIMITED"
      ],
      "title": "CallStatus",
      "type": "string"
    },
    "ErrorCategory": {
      "enum": [
        "VALIDATION",
        "PRIVACY",
        "PROVIDER",
        "PROVIDER_TIMEOUT",
        "RATE_LIMIT",
        "ROUTING",
        "EVALUATION",
        "PERSISTENCE",
        "UNKNOWN"
      ],
      "title": "ErrorCategory",
      "type": "string"
    },
    "ErrorInfo": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/ErrorCategory"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "safe_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Safe Message"
        }
      },
      "required": [
        "category",
        "code"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "MetricOrigin": {
      "enum": [
        "SIMULATED",
        "OBSERVED"
      ],
      "title": "MetricOrigin",
      "type": "string"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "description": "Counts are nullable; reasoning/cached may overlap other totals.",
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "cached_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cached Tokens"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Tokens"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Ephemeral response; content must be sanitized before any persistence.",
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^1\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "attempt_id": {
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/CallStatus"
    },
    "metric_origin": {
      "$ref": "#/$defs/MetricOrigin"
    },
    "content": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/TokenUsage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "latency_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency Ms"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provider_request_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Request Id"
    }
  },
  "required": [
    "provider",
    "model",
    "attempt_id",
    "status",
    "metric_origin"
  ],
  "title": "ModelResponse",
  "type": "object"
}
